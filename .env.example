# Copy to .env and fill in. .env is gitignored -- never commit credentials.
#
# For Gmail you must use an App Password (Google Account -> Security ->
# 2-Step Verification -> App passwords), not your normal password.
# Enable IMAP first in Gmail Settings -> Forwarding and POP/IMAP.

UNIFLOW_IMAP_HOST=imap.gmail.com
UNIFLOW_IMAP_PORT=993
UNIFLOW_IMAP_USER=your.inquiries.address@gmail.com
UNIFLOW_IMAP_PASSWORD=your-16-character-app-password
UNIFLOW_IMAP_FOLDER=INBOX

UNIFLOW_SMTP_HOST=smtp.gmail.com
UNIFLOW_SMTP_PORT=587
# Defaults to the IMAP credentials if omitted.
# UNIFLOW_SMTP_USER=
# UNIFLOW_SMTP_PASSWORD=

# Set to 0 to classify and store without emailing acknowledgements back.
# Keep it at 0 while testing so you do not mail real people.
UNIFLOW_SEND_ACK=0
